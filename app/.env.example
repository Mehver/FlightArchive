# Paths are resolved relative to app/ (the Compose file directory).
# Existing host directory that RFG exposes read-only.
RFG_RESOURCE_HOST_PATH=../data/resource
# Writable host directory for RFG mapping state and FlightArchive business data.
RFG_DATA_HOST_PATH=../data/runtime
# Optional: only used with compose.cache-host.yaml to retain the disposable
# thumbnail cache on a host directory. Leave unset for the default ephemeral cache.
# FLIGHTARCHIVE_CACHE_HOST_PATH=../cache
